# pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
# --no-rehash: skip rebuilding shims at every shell start (run `pyenv rehash` after installing a tool)
command -v pyenv >/dev/null && eval "$(pyenv init - --no-rehash bash)"

export PYTHONSTARTUP=$HOME/.pythonstartup
