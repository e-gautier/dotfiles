export NVM_DIR="$HOME/.nvm"

# Sourcing nvm.sh costs ~200ms per shell. Instead, put the newest installed
# node on PATH (the default alias is lts/*) and load nvm on first use.
if [ -d "$NVM_DIR/versions/node" ]; then
    __nvm_bin=$(ls -d "$NVM_DIR"/versions/node/v*/bin 2>/dev/null | sort -V | tail -n 1)
    [ -n "$__nvm_bin" ] && PATH="$__nvm_bin:$PATH"
    unset __nvm_bin
fi

nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
    nvm "$@"
}
