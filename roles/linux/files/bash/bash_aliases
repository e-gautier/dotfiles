# ping-scan the LAN of the default route interface (computed at call time)
nmapthis() {
  local dev net
  dev=$(ip route show default | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
  [ -n "$dev" ] || { echo "nmapthis: no default route" >&2; return 1; }
  net=$(ip -o -4 addr show dev "$dev" | awk '{print $4; exit}')
  [ -n "$net" ] || { echo "nmapthis: no IPv4 address on $dev" >&2; return 1; }
  nmap -sn "$net" "$@"
}
