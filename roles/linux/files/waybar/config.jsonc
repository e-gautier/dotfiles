// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 26,
    "spacing": 5,
    "reload_style_on_change": true,
    "modules-left": [
        "sway/workspaces",
        "sway/window",
        "sway/mode"
    ],
    "modules-right": [
        "sway/language",
        "custom/caps",
        "pulseaudio",
        "backlight",
        "disk",
        "network",
        "memory",
        "custom/fan",
        "temperature",
        "load",
        "battery",
        "clock",
        "custom/screenshot",
        "tray"
    ],
    "custom/caps": {
        "exec": "grep -qx 1 /sys/class/leds/*::capslock/brightness && echo '{\"class\": \"locked\"}' || echo '{}'",
        "return-type": "json",
        "format": "CAPS",
        "signal": 8,
        "interval": 5
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 3
    },
    "clock": {
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M %d/%m/%Y}",
        "on-click": "gnome-calendar"
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "events": {
            "on-discharging-warning": "notify-send -u critical 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
        },
        "format": "Bat:{capacity}% ({power}W)",
        "format-full": "Bat:{capacity}% ({power}W)",
        "format-charging": "->Bat:{capacity}% ({power}W)"
    },
    "load": {
        "format": "L:{load1}"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 5
    },
    "custom/fan": {
        "exec": "cat /sys/devices/platform/thinkpad_hwmon/hwmon/hwmon*/fan1_input",
        "interval": 5,
        "format": "F:{}"
    },
    "memory": {
        "interval": 10,
        "format": "M:{percentage}% S:{swapPercentage}%"
    },
    "network": {
        "format-wifi": "{signalStrength}% {ifname}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "Net:off"
    },
    "disk": {
        "path": "/home",
        "format": "/home {percentage_used}%/{total}"
    },
    "backlight": {
        "format": "BL:{percent}%"
    },
    "pulseaudio": {
        "format": "{format_source} Out:{volume}%",
        "format-muted": "{format_source} Out:Mut",
        "format-source": "In:{volume}%",
        "format-source-muted": "In:Mut"
    },
    "custom/screenshot": {
        "format": "SCR",
        "tooltip-format": "left: area, right: screen",
        "on-click": "grimshot save area - | swappy -f -",
        "on-click-right": "grimshot save screen - | swappy -f -"
    }
}
