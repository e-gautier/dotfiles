#!/usr/sbin/nft -f

table inet filter {
	set tcp_open {
		type inet_service
	}

	set udp_open {
		type inet_service
	}

	chain INPUT {
		type filter hook input priority 0
		policy drop

		# lo accept all
		iifname lo accept

		# accept connection states established, related
		ct state established,related accept
		ct state invalid drop

		# ipv6 neighbor discovery
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, mld-listener-query, packet-too-big, destination-unreachable, time-exceeded, parameter-problem } accept

		# dhcpv6 client
		ip6 saddr fe80::/10 udp dport 546 accept

		# syncthing
		tcp dport 22000 accept
		udp dport { 21027, 22000 } accept

		# openport* helpers
		# ports added/removed at runtime via nft add/delete element
		tcp dport @tcp_open accept
		udp dport @udp_open accept

		log prefix "[netfilter] INPUT (drop) " level debug
	}

	chain FORWARD {
		type filter hook forward priority 0
		policy accept

		log prefix "[netfilter] FORWARD " level debug
	}

	chain OUTPUT {
		type filter hook output priority 0
		policy accept
	}
}
