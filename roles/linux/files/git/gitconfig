  	email = etienne.gautier@protonmail.com
[github]
    user = e-gautier
[core]
    editor = vim
    fileMode = false
    pager = delta
[alias]
    aliases = !git config -l | grep alias | cut -c 7-
    plog = log --graph  --pretty=format:'%C(auto)%h %ad %an %d %s %gn' --abbrev-commit --all --date=format:'%H:%M %d/%m/%Y'
    a = add
    b = branch
    c = commit -s
    cl = clone
    d = diff
    st = status
    f = fetch
    ck = checkout
    p = push --force-with-lease
    pl = pull
    fom = fetch origin master:master
    recent = branch -v --sort=-committerdate
    undo = reset --soft HEAD^
    recommit = commit --reedit-message ORIG_HEAD
[commit]
    gpgSign = true
[tag]
    gpgSign = true
[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[diff]
    tool = vimdiff
    algorithm = histogram
[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true
[pull]
    rebase = true
[rerere]
    enabled = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    keep-plus-minus-markers = false
    syntax-theme = none
